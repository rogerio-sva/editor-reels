{
  "name": "editor-reels",
  "version": "1.0.0",
  "private": true,
  "description": "Editor de Reels com motion graphics pelo Claude Code: corta erros e silêncios, trata a voz, legenda, modelos prontos e conferência automática.",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render",
    "still": "remotion still",
    "typecheck": "tsc --noEmit",
    "tempos": "node scripts/tempos-de-texto.mjs",
    "stills": "node scripts/stills.mjs",
    "batidas": "node scripts/batidas.mjs",
    "prancha": "node scripts/prancha.mjs",
    "trilha": "node scripts/trilha.mjs",
    "preparar": "node scripts/preparar-video.mjs",
    "estudio-edicao": "remotion studio src/editor/index.ts",
    "test": "node --test --test-concurrency=1 \"tests/*.test.*\""
  },
  "dependencies": {
    "@remotion/bundler": "4.0.409",
    "@remotion/cli": "4.0.409",
    "@remotion/google-fonts": "4.0.409",
    "@remotion/install-whisper-cpp": "4.0.409",
    "@remotion/paths": "4.0.409",
    "@remotion/renderer": "4.0.409",
    "@remotion/transitions": "4.0.409",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.409"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "typescript": "5.7.2"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  }
}